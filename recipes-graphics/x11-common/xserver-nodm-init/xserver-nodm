# /etc/default/xserver-nodm
#
# Read by /etc/xserver-nodm/Xserver which calls:
#   xinit /etc/X11/Xsession -- $XSERVER $DISPLAY $ARGS
#
# Variable names MUST match what the Xserver script uses.
# xserver-nodm.service runs as User=root (ROOTLESS_X is not set),
# so HOME=/root and the session runs as root.

XSERVER=/usr/bin/Xorg
DISPLAY=:0
ARGS="-br -pn -nolisten tcp -s 0 -dpms"
HOME=/root
USER=root
