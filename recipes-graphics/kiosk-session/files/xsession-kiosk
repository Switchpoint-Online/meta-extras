#!/bin/sh
[ -f /etc/default/tdn-kiosk ] && . /etc/default/tdn-kiosk
: "${KIOSK_URL:=http://127.0.0.1:1880}"
export NO_AT_BRIDGE=1

PROFILE_DIR="$HOME/.local/share/epiphany-kiosk"
mkdir -p "$PROFILE_DIR"
[ -f "$PROFILE_DIR/.app" ] || : > "$PROFILE_DIR/.app"

matchbox-window-manager -use_titlebar no -use_cursor yes &
exec epiphany --application-mode --profile="$PROFILE_DIR" "$KIOSK_URL"
