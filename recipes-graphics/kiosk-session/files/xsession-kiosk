#!/bin/sh
# URL is set by /etc/default/tdn-kiosk (sourced below).
# The fallback here only fires if that file is missing or corrupt.
[ -f /etc/default/tdn-kiosk ] && . /etc/default/tdn-kiosk
: "${KIOSK_URL:=http://127.0.0.1/}"
export NO_AT_BRIDGE=1

xset s off   || true
xset -dpms   || true
xset s noblank || true

# Fill the X root window with the psplash background colour so there is no
# black flash between the framebuffer splash and the first Chromium paint.
xsetroot -solid '#ecece1' || true

# Dismiss the framebuffer psplash now that X owns the display.
# psplash listens on a FIFO; send QUIT then stop the service so the framebuffer
# is fully released before Chromium initialises the GPU.
echo "QUIT" > /tmp/psplash_fifo 2>/dev/null || true
systemctl stop psplash.service 2>/dev/null || true

# Wait for Node-RED HTTP server to be ready before launching Chromium.
# Node-RED runs on port 80 (uiPort=80 in settings.js).
# Without this, Chromium shows a connection-refused error page and there is
# no way to dismiss it (no SSH, no shell — kiosk is the only local UI).
# Use wget --spider: checks TCP+HTTP reachability without downloading body.
# 45 attempts × 2 s = 90 s ceiling (covers slow first-boot Node-RED start).
n=0
while [ $n -lt 45 ]; do
    wget -q --spider http://127.0.0.1 2>/dev/null
    rc=$?
    # rc=0: 2xx (server up, no auth)
    # rc=8: 4xx/5xx (server up, e.g. 401 if httpNodeAuth is set)
    # rc=4: connection refused (server not up yet) → keep waiting
    [ "$rc" -eq 0 ] || [ "$rc" -eq 8 ] && break
    n=$((n + 1))
    sleep 2
done

/usr/bin/chromium \
    --kiosk \
    --no-sandbox \
    --disable-setuid-sandbox \
    --disable-dev-shm-usage \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-restore-session-state \
    --noerrdialogs \
    --no-first-run \
    --disable-sync \
    --check-for-update-interval=31536000 \
    --force-device-scale-factor=1 \
    --window-position=0,0 \
    --user-data-dir=/tmp/chromium-kiosk \
    "$KIOSK_URL" &

CHROMIUM_PID=$!

# Recovery watchdog: if Node-RED goes down after the kiosk is running, Chromium
# will show ERR_CONNECTION_REFUSED and stay frozen on it.  Kill Chromium every
# 30 s when Node-RED is unreachable — xserver-nodm (Restart=always) will restart
# the whole X session, re-running this script and its 90 s wait loop.
while kill -0 "$CHROMIUM_PID" 2>/dev/null; do
    sleep 30
    wget -q --spider http://127.0.0.1 2>/dev/null
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 8 ]; then
        kill "$CHROMIUM_PID" 2>/dev/null
        break
    fi
done

wait "$CHROMIUM_PID" 2>/dev/null
